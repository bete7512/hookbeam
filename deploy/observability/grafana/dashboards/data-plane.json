{
  "uid": "hookbeam-data",
  "title": "Hookbeam \u00b7 data plane",
  "tags": [
    "hookbeam"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Messages accepted per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(hookbeam_messages_accepted_total[5m])) * 60",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(hookbeam_messages_rejected_total[5m])) * 60",
          "legendFormat": "rejected {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Attempts per minute by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(hookbeam_attempts_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert: Repeated failures watches outcome=failed."
    },
    {
      "id": 3,
      "title": "Attempts per minute by response class",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(hookbeam_attempts_total[5m])) * 60",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Oldest due delivery age",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookbeam_deliveries_oldest_due_age)",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "A due delivery nobody claimed. Alert: Oldest due age, Stalled workers."
    },
    {
      "id": 5,
      "title": "Attempts in flight",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookbeam_deliveries_in_flight)",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "title": "Outbox lag (data plane)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookbeam_outbox_oldest_age{job=\"delivery-worker\"})",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Alert: Outbox lag."
    },
    {
      "id": 7,
      "title": "Claims per minute",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookbeam_claims_batch_size_count[5m])) * 60",
          "legendFormat": "claims"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Zero with a backlog means the workers are stalled."
    },
    {
      "id": 8,
      "title": "Retries and exhaustions per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookbeam_retries_total[5m])) * 60",
          "legendFormat": "retries"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(hookbeam_exhaustions_total[5m])) * 60",
          "legendFormat": "exhausted {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "gRPC server p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_server_call_duration_seconds_bucket{job=\"delivery\"}[5m])))",
          "legendFormat": "{{rpc_method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "delivery and worker logs (warnings and errors)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"delivery|delivery-worker\"} |~ \"WARN|ERROR\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": []
  }
}
