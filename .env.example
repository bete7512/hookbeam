# Copy to .env — docker compose and `task` read it; the services read only their own vars.
# Every value here is a local-dev default. Never put real secrets in this file.

# ── service identity ──────────────────────────────────────────────────────────
APP_ENV=dev                 # dev | staging | prod — drives log format and defaults
APP_SERVICE=api             # overridden per binary (api, worker)
APP_VERSION=dev             # git SHA in CI; used in logs and Sentry release

# ── http ──────────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_INTERNAL_ADDR=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576 # 1 MiB

# ── logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=json             # text (dev) | json (everything else)

# ── postgres (compose `core` profile) ─────────────────────────────────────────
POSTGRES_USER=hookbeam
POSTGRES_PASSWORD=hookbeam
POSTGRES_DB=hookbeam
POSTGRES_PORT=5433                # 5433 because 5432 is commonly taken by a host Postgres
DATABASE_URL=postgres://hookbeam:hookbeam@localhost:5433/hookbeam?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTHCHECK_PERIOD=30s


# ── auth ────────────────────────────────────────────────────────────────────
AUTH_JWT_SIGNING_KEY=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# ── tests ─────────────────────────────────────────────────────────────────────
# When set, integration tests use this DB instead of starting a testcontainer
# (CI sets it to the postgres service container).
AUTH_ACTION_TOKEN_KEY=
AUTH_SECRET_KEY=                   # at least 32 chars: cookie encoding (and HS256 signing)
AUTH_ENCRYPTION_KEY=               # at least 32 chars: secrets at rest; must differ from AUTH_SECRET_KEY
AUTH_JWT_PRIVATE_KEY=              # base64 of a PKCS#8 PEM (setup generates a P-256 key); or AUTH_JWT_PRIVATE_KEY_FILE=
AUTH_ALLOW_INSECURE_COOKIES=true           # local HTTP only; staging/prod refuse it
MAILER_BACKEND=memory             # smtp (Mailpit from `make queue-up`) | ses | memory
MAILER_SMTP_ADDR=

# ── delivery service (data plane) ─────────────────────────────────────────────
DELIVERY_DATABASE_URL=postgres://hookbeam:hookbeam@localhost:5433/hookbeam_delivery?sslmode=disable
DELIVERY_GRPC_ADDR=:9090
DELIVERY_TLS_CERT_FILE=deploy/certs/server.crt   # from `make certs`
DELIVERY_TLS_KEY_FILE=deploy/certs/server.key
DELIVERY_TLS_CA_FILE=deploy/certs/ca.crt
DELIVERY_EVENTS_BACKEND=memory                    # aws (LocalStack or AWS) | memory
DELIVERY_SECRETS_KEY=                             # base64 of 32 random bytes; encrypts endpoint signing secrets at rest (`make setup` fills it)
DELIVERY_CLIENT_ADDR=localhost:9090
DELIVERY_CLIENT_TLS_CERT_FILE=deploy/certs/client.crt
DELIVERY_CLIENT_TLS_KEY_FILE=deploy/certs/client.key
DELIVERY_CLIENT_TLS_CA_FILE=deploy/certs/ca.crt
