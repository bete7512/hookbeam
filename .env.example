# Copy to .env — docker compose and `make` read it; the services read only their own vars.
# Every value here is a local-dev default. Never put real secrets in this file.

# ── service identity ──────────────────────────────────────────────────────────
APP_ENV=dev                 # dev | staging | prod — drives log format and defaults
APP_SERVICE=api             # overridden per binary (api, worker)
APP_VERSION=dev             # git SHA in CI; used in logs and Sentry release

# ── http ──────────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_INTERNAL_ADDR=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576 # 1 MiB
HTTP_TRUST_PROXY=false      # true behind the load balancer: client IP from X-Forwarded-For

# ── logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=json             # text (dev) | json (everything else)

# ── postgres (compose `core` profile) ─────────────────────────────────────────
POSTGRES_USER=scaffold
POSTGRES_PASSWORD=scaffold
POSTGRES_DB=scaffold
POSTGRES_PORT=5433                # 5433 because 5432 is commonly taken by a host Postgres
DATABASE_URL=postgres://scaffold:scaffold@localhost:5433/scaffold?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTHCHECK_PERIOD=30s


# ── auth ────────────────────────────────────────────────────────────────────
AUTH_JWT_SIGNING_KEY=
AUTH_ACTION_TOKEN_KEY=           # independent 32-byte base64 secret; setup fills both keys
AUTH_RECIPIENT_COOLDOWN=1m
AUTH_ISSUER=scaffold
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_ACTION_TOKEN_TTL=30m          # email verification and password reset links
AUTH_LINK_BASE_URL=http://localhost:3000   # frontend origin the links in emails point to

# Rate limits on /v1/auth/* and registration (per client IP) and on login (per account), counted per replica
RATELIMIT_AUTH_LIMIT=5
RATELIMIT_AUTH_WINDOW=1m
RATELIMIT_REGISTER_LIMIT=5
RATELIMIT_REGISTER_WINDOW=1m
RATELIMIT_RECOVERY_LIMIT=5
RATELIMIT_RECOVERY_WINDOW=1m
RATELIMIT_SESSION_LIMIT=60
RATELIMIT_SESSION_WINDOW=1m
RATELIMIT_LOGIN_LIMIT=5
RATELIMIT_LOGIN_WINDOW=15m

# In-process cache shared by the app (rate-limit counters live here; each replica counts on its own)
CACHE_MAX_ITEMS=100000

# Google login; leave the client id empty to keep the routes disabled (503)
OIDC_DISCOVERY_TIMEOUT=10s
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# ── events / outbox / mail (compose profile `queue`: LocalStack + Mailpit) ───────────────
EVENTS_BACKEND=aws                # aws | memory (memory: no queue, events dropped after the outbox)
EVENTS_AWS_REGION=us-east-1
EVENTS_AWS_ENDPOINT_URL=http://localhost:4566
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:scaffold-events
EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/scaffold-worker
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_HANDLER_TIMEOUT=2m
OUTBOX_PUBLISH_TIMEOUT=30s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION=168h
MAILER_BACKEND=smtp               # smtp | ses | memory
MAILER_SMTP_ADDR=localhost:1025
MAILER_FROM=no-reply@scaffold.local
